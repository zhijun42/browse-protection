{
  "manifest_version": 3,
  "name": "Morning Protection",
  "version": "1.1.0",
  "description": "定时屏蔽网站，按网站分别计算学习和娱乐时间，到点停下来再做选择。",
  "permissions": [
    "declarativeNetRequest",
    "alarms",
    "storage",
    "tabs",
    "idle",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Morning Protection"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
